APP_NAME=3D Printer Farm Backend
APP_ENV=development
API_V1_PREFIX=/api

# Prefer Supabase Session pooler (IPv4) inside Docker Desktop on macOS.
# Example: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Auth: fake (tests/local) or supabase (real Auth). Never commit real keys.
AUTH_ADAPTER=fake
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET_KEY=replace-me-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000

FILE_STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=52428800

PRINTER_ADAPTER=mock
MOCK_PRINTER_BASE_URL=http://localhost:8080
