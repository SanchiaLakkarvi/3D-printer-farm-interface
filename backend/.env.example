APP_NAME=3D Printer Farm Backend
APP_ENV=development
API_PREFIX=/api

# Prefer Supabase Session pooler (IPv4) inside Docker Desktop on macOS.
# Example: postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Auth: fake (tests/local) or supabase (real Auth). Never commit real keys.
AUTH_ADAPTER=fake
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET_KEY=replace-me-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated. Include Vite (5173) and Next (3000) for local UI.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

FILE_STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=52428800

PRINTER_ADAPTER=mock
MOCK_PRINTER_BASE_URL=http://localhost:8080

# Public student troubleshooting chat. Empty key keeps the UI entry visible but
# makes POST /api/help/chat return 503 HELP_UNAVAILABLE.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Local backend runs from backend/; Compose overrides this with /app/help.
HELP_DOCS_ROOT=../Docs/help
HELP_MAX_MESSAGE_CHARS=1000
HELP_MAX_HISTORY_MESSAGES=6
HELP_MAX_OUTPUT_TOKENS=400
HELP_RATE_LIMIT_REQUESTS=10
HELP_RATE_LIMIT_WINDOW_SECONDS=60
HELP_PROVIDER_TIMEOUT_S=10
